\pard\sa200\sl276\slmult1\f0\fs22\lang9 EPISODE 1 \f1\emdash  What Trauma Does to a Child\rquote s Brain\par
json\par
\{\par
  "episode": 1,\par
  "title": "What Trauma Does to a Child\rquote s Brain",\par
  "keyMessage": "Trauma shifts the brain into survival mode.",\par
  "cards": [\par
    "A child\rquote s brain becomes focused on danger, not learning.",\par
    "Survival mode makes listening and sitting still difficult.",\par
    "Their reactions are protective, not intentional."\par
  ],\par
  "reflection": [\par
    "When does my child seem most overwhelmed?",\par
    "What situations make them feel unsafe?"\par
  ],\par
  "actions": [\par
    "Lower your voice and slow your movements.",\par
    "Offer simple choices.",\par
    "Create a calm, predictable environment."\par
  ]\par
\}\par
EPISODE 2 \emdash  Why Trauma Looks Like Misbehaviour\par
json\par
\{\par
  "episode": 2,\par
  "title": "Why Trauma Looks Like Misbehaviour",\par
  "keyMessage": "Behaviour is communication.",\par
  "cards": [\par
    "Children show their needs through behaviour.",\par
    "Lying may be fear of punishment.",\par
    "Stealing food may be fear of scarcity.",\par
    "Tantrums may be emotional overload."\par
  ],\par
  "reflection": [\par
    "What behaviours confuse me most?",\par
    "What might my child be trying to communicate?"\par
  ],\par
  "actions": [\par
    "Pause before reacting.",\par
    "Stay curious instead of assuming.",\par
    "Look beneath the behaviour for the need."\par
  ]\par
\}\par
EPISODE 3 \emdash  Fight, Flight, Freeze, Fawn\par
json\par
\{\par
  "episode": 3,\par
  "title": "Fight, Flight, Freeze, Fawn",\par
  "keyMessage": "These are survival responses, not choices.",\par
  "cards": [\par
    "Fight: yelling, hitting, arguing.",\par
    "Flight: running away or hiding.",\par
    "Freeze: shutting down or going blank.",\par
    "Fawn: people-pleasing to stay safe."\par
  ],\par
  "reflection": [\par
    "Which stress response does my child use most?",\par
    "How do I usually react to it?"\par
  ],\par
  "actions": [\par
    "Stay close and calm during stress responses.",\par
    "Use grounding tools like breathing or counting.",\par
    "Reduce demands when your child is overwhelmed."\par
  ]\par
\}\par
EPISODE 4 \emdash  Emotional Regulation & Meltdowns\par
json\par
