        "id": "behaviour-as-communication",
        "title": "Behaviour as Communication",
        "keyMessage": "Behaviour is communication, not defiance.",
        "summary": "Children communicate their needs through behaviour when they cannot express them in words. Understanding the need beneath the behaviour helps parents respond with connection instead of correction.",
        "cards": [
          "All behaviour has meaning.",
          "Children show needs through actions when they cannot express them verbally.",
          "Understanding the need behind the behaviour changes how you respond."
        ],
        "actions": [
          "Pause before reacting.",
          "Ask yourself: 'What is my child trying to communicate?'",
          "Respond to the need, not the behaviour."
        ],
        "reflection": [
          "What behaviour is hardest for me to understand?",
          "What need might be underneath that behaviour?"
        ]
      },
      {
        "id": "behaviour-decoder-toolkit",
        "title": "Behaviour Decoder Toolkit",
        "keyMessage": "Behaviour is a message. Your job is to decode it.",
        "process": [
          "Pause – slow your body and voice.",
          "Observe – what do you see, hear, or notice?",
          "Decode – ask: 'What is the need behind this behaviour?'",
          "Respond – meet the need with connection and support."
        ],
