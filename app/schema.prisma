datasource db {
  provider = 'sqlite'
  url      = 'file:./dev.db'
}

generator client {
  provider = 'prisma-client-js'
}

model Channel {
  id               String   @id @default(cuid())
  childId          String
  parentId         String
  caseId           String?
  state            String   @default('ACTIVE')
  lastChangedBy    String?
  lastChangeReason String?
  messages         Message[]
  auditLogs        AuditLog[]
}

model Message {
  id             String   @id @default(cuid())
  channelId      String
  fromUserId     String
  toUserId       String
  body           String
  delivered      Boolean
  moderationTier Int
  rulesMatched   Json
  createdAt      DateTime @default(now())
  channel        Channel  @relation(fields: [channelId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  event     String
  details   String
  createdAt DateTime @default(now())
  channelId String?
  channel   Channel? @relation(fields: [channelId], references: [id])
}
