{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Extended30MinLessonSchema",
  "type": "object",
  "required": [
    "lessonId",
    "courseId",
    "title",
    "metadata",
    "aiFacilitatorConfig",
    "openingReflection",
    "content",
    "assessments",
    "guidedActivities",
    "actionableTakeaways",
    "reflectionQuestions"
  ],
  "properties": {
    "lessonId": {
      "type": "string"
    },
    "courseId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "required": ["version", "estimatedDurationMinutes", "targetAudience"],
      "properties": {
        "version": { "type": "string" },
        "estimatedDurationMinutes": { 
          "type": "integer", 
          "minimum": 30,
          "description": "Must be set to 30 minutes or longer to allow for deep reflection, extended practice, and AI-guided discussion."
        },
        "targetAudience": { "type": "string" },
        "prerequisites": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "aiFacilitatorConfig": {
      "type": "object",
      "required": ["personaRole", "facilitationStrategy", "interactionRules", "pacingConfig", "systemPrompts"],
      "properties": {
        "personaRole": { "type": "string" },
        "facilitationStrategy": { "type": "string" },
        "pacingConfig": {
          "type": "object",
          "description": "Time management guidelines for the AI facilitator across the 30+ minute session duration",
          "properties": {
            "openingReflectionMinutes": { "type": "integer", "default": 5 },
            "coreInstructionMinutes": { "type": "integer", "default": 10 },
            "interactiveAssessmentsMinutes": { "type": "integer", "default": 5 },
            "guidedActivityMinutes": { "type": "integer", "default": 7 },
            "closingReflectionMinutes": { "type": "integer", "default": 3 }
          }
        },
        "interactionRules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "systemPrompts": {
          "type": "object",
          "properties": {
            "openingGreetingPrompt": { "type": "string" },
            "quizFacilitationPrompt": { "type": "string" },
            "activityGuidancePrompt": { "type": "string" },
            "closingReflectionPrompt": { "type": "string" }
          }
        }
      }
    },
    "openingReflection": {
      "type": "object",
      "required": ["prompt", "guidance"],
      "properties": {
        "prompt": { "type": "string" },
        "guidance": { "type": "string" }
      }
    },
    "content": {
      "type": "object",
      "required": ["overview", "coreText", "keyConcepts"],
      "properties": {
        "overview": { "type": "string" },
        "coreText": { "type": "string" },
        "keyConcepts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["concept", "description"],
            "properties": {
              "concept": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "question", "options"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "enum": ["multiple-choice", "open-ended", "scenario-analysis"] },
          "question": { "type": "string" },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "text", "isCorrect", "explanation"],
              "properties": {
                "id": { "type": "string" },
                "text": { "type": "string" },
                "isCorrect": { "type": "boolean" },
                "explanation": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "guidedActivities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["activityId", "title", "objective", "estimatedDurationMinutes", "steps"],
        "properties": {
          "activityId": { "type": "string" },
          "title": { "type": "string" },
          "objective": { "type": "string" },
          "estimatedDurationMinutes": { "type": "integer" },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["stepNumber", "instruction"],
              "properties": {
                "stepNumber": { "type": "integer" },
                "instruction": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "actionableTakeaways": {
      "type": "array",
      "items": { "type": "string" }
    },
    "reflectionQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question"],
        "properties": {
          "id": { "type": "string" },
          "question": { "type": "string" }
        }
      }
    }
  }
}