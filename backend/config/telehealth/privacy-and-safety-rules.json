{
  "recordingRules": {
    "disabledByDefault": true,
    "requiresExplicitPolicyApproval": true,
    "requiresParticipantConsent": true,
    "requiresVisibleNotice": true,
    "requiresStartStopAuditEvents": true,
    "encryptedStorage": true,
    "accessRestrictions": true,
    "retentionPolicy": "organisation_policy",
    "exportControls": true
  },
  "childSafetyRules": {
