# Public Expo client config
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_JWKS_URL=
EXPO_PUBLIC_AUTH_REDIRECT_URL=http://localhost:8099/welcome

# The external curriculum API is disabled by default because the built-in reviewed
# curriculum is the canonical launch source. Enable only after matching
# /curriculum/courses and /curriculum/lessons endpoints are deployed.
EXPO_PUBLIC_SAFESTEPS_CURRICULUM_API_ENABLED=false
EXPO_PUBLIC_SAFESTEPS_API_URL=

# Calibration scoring, readiness, and court-report previews remain hidden from
# the launch runtime unless a controlled review environment explicitly enables them.
EXPO_PUBLIC_SAFESTEPS_ENABLE_ADVANCED_ASSESSMENT_PREVIEWS=false

# Server/local tooling config
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Comma-separated browser origins. Native requests without an Origin header are allowed.
SAFESTEPS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8099,http://localhost:19006

# Local-only escape hatch for backend smoke tests. Never set this to true in staging or production.
SAFESTEPS_ALLOW_UNAUTHENTICATED_LOCAL_API=false
