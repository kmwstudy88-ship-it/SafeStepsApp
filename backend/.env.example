# SafeSteps backend
PORT=3000
BACKEND_ALLOWED_ORIGINS=*

# Supabase server-side credentials. Never expose the service-role key in Expo/public env.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Select one AI provider: openai or anthropic
DOCUMENT_AI_PROVIDER=openai
DOCUMENT_AI_WORKER_INTERVAL_MS=2500

# OpenAI
OPENAI_API_KEY=
OPENAI_DOCUMENT_MODEL=gpt-5.6-terra
OPENAI_DOCUMENT_REASONING=medium

# Anthropic (used when DOCUMENT_AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_DOCUMENT_MODEL=claude-sonnet-4-5

# Expo app points this at the deployed Node backend, for example:
# EXPO_PUBLIC_BACKEND_URL=https://api.example.com
