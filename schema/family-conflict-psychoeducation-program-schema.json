{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safesteps.app/schema/family-conflict-psychoeducation-program-schema.json",
  "title": "Family Conflict Psychoeducation Program",
  "type": "object",
  "required": [
    "title",
    "levels",
    "audience",
    "lesson_duration_minutes",
    "safeguards",
    "lessons",
    "completion_guidance",
    "reusable_assessments"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "levels": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "enum": ["Basic", "Developing", "Mastery"] }
    },
    "audience": { "type": "string", "minLength": 1 },
    "lesson_duration_minutes": {
      "type": "object",
      "required": ["Basic", "Developing", "Mastery"],
      "properties": {
        "Basic": { "type": "string" },
        "Developing": { "type": "string" },
        "Mastery": { "type": "string" }
      }
    },
    "safeguards": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "lessons": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["id", "title", "learning_goal", "levels"],
        "properties": {
          "id": { "type": "integer", "minimum": 1, "maximum": 20 },
          "title": { "type": "string", "minLength": 1 },
          "learning_goal": { "type": "string", "minLength": 1 },
          "levels": {
            "type": "object",
            "required": ["Basic", "Developing", "Mastery"],
            "properties": {
              "Basic": { "$ref": "#/$defs/levelDetail" },
              "Developing": { "$ref": "#/$defs/levelDetail" },
              "Mastery": { "$ref": "#/$defs/levelDetail" }
            }
          }
        }
      }
    },
    "completion_guidance": {
      "type": "object",
      "required": ["Basic", "Developing", "Mastery", "progression"],
      "properties": {
        "Basic": { "$ref": "#/$defs/completionDetail" },
        "Developing": { "$ref": "#/$defs/completionDetail" },
        "Mastery": { "$ref": "#/$defs/completionDetail" },
        "progression": { "type": "string", "minLength": 1 }
      }
    },
    "reusable_assessments": {
      "type": "object",
      "required": ["exit_ticket", "role_play_rubric", "learning_journal_prompts"],
      "properties": {
        "exit_ticket": { "type": "array", "minItems": 4, "items": { "type": "string" } },
        "role_play_rubric": {
          "type": "object",
          "required": ["scoring", "criteria"],
          "properties": {
            "scoring": {
              "type": "object",
              "required": ["0", "1", "2"],
              "properties": {
                "0": { "type": "string" },
                "1": { "type": "string" },
                "2": { "type": "string" }
              }
            },
            "criteria": { "type": "array", "minItems": 5, "items": { "type": "string" } }
          }
        },
        "learning_journal_prompts": { "type": "array", "minItems": 5, "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "levelDetail": {
      "type": "object",
      "required": ["activity", "assessment"],
      "properties": {
        "activity": { "type": "string", "minLength": 1 },
        "assessment": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "completionDetail": {
      "type": "object",
      "required": ["description", "evidence"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
