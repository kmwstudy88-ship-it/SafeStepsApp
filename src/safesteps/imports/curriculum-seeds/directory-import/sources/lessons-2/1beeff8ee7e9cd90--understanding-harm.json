  "definition": {
    "title": "What Does Understanding Harm Mean?",
    "content": "Understanding harm means recognising how behaviours, actions, decisions, communication styles, environmental factors and unmet needs can negatively affect a child's emotional, psychological, physical, social and developmental wellbeing."
  },

  "learningObjectives": [
    "Identify different forms of child harm",
    "Understand emotional and psychological impacts",
    "Recognise cumulative effects of harmful experiences",
    "Develop accountability skills",
    "Build practical repair strategies",
    "Create emotionally safe environments"
  ],

  "learningOutcomes": [
    "Recognise emotional harm indicators",
    "Describe the impact of harmful experiences",
    "Demonstrate responsibility taking",
    "Identify child-centred repair actions",
    "Create plans for safer parenting practices"
  ],

  "lessonSections": [
    {
      "sectionId": "LS001",
      "title": "Understanding Harm",
      "duration": 10,
      "content": [
        "Harm is not always intentional.",
        "Children can be harmed emotionally, psychologically, physically and developmentally.",
        "Harm may occur through actions or failure to act.",
        "Children experience situations differently from adults.",
        "Perception of safety matters as much as actual safety."
      ]
    },
    {
      "sectionId": "LS002",
      "title": "Impact on Child Development",
      "duration": 10,
      "content": [
        "Impact on emotional regulation.",
        "Impact on self-esteem.",
        "Impact on attachment.",
        "Impact on behaviour.",
        "Impact on trust and relationships."
      ]
    },
    {
      "sectionId": "LS003",
      "title": "Recognising Signs of Harm",
      "duration": 10,
      "content": [
        "Withdrawal from others.",
        "Increased anxiety.",
        "Aggressive behaviours.",
        "Sleep disturbances.",
        "Emotional outbursts.",
        "Developmental regression."
      ]
    },
    {
      "sectionId": "LS004",
      "title": "Repair and Accountability",
      "duration": 15,
      "content": [
        "Acknowledging impact.",
        "Taking responsibility.",
        "Listening without defensiveness.",
        "Creating change plans.",
        "Rebuilding trust through consistency."
      ]
    }
  ],

  "activities": [
    {
      "id": "ACT001",
      "type": "reflection",
