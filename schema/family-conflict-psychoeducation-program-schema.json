        "assessment": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "completionDetail": {
      "type": "object",
      "required": [
        "description",
        "evidence"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "lessonEntry": {
      "type": "object",
      "required": [
        "id",
        "title",
        "learning_goal",
        "levels"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "learning_goal": {
          "type": "string",
          "minLength": 1
        },
        "levels": {
          "type": "object",
          "required": [
            "Basic",
            "Developing",
            "Mastery"
          ],
          "properties": {
            "Basic": {
