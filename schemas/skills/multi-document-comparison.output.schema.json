{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safesteps.app/schemas/skills/multi-document-comparison.output.schema.json",
  "title": "Multi-Document Comparison — Skill Output",
  "description": "Output schema for the SafeSteps Multi-Document Comparison skill.",
  "type": "object",
  "required": ["case_id", "comparisons", "summary", "run_meta"],
  "properties": {
    "case_id": { "type": "string" },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topic", "document_positions", "alignment", "significance", "confidence"],
        "properties": {
          "topic": { "type": "string", "minLength": 1 },
          "document_positions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["doc_id", "position", "source_span"],
              "properties": {
                "doc_id": { "type": "string" },
                "position": { "type": "string" },
                "source_span": {
                  "type": "object",
                  "required": ["start", "end"],
                  "properties": {
                    "start": { "type": "integer", "minimum": 0 },
                    "end": { "type": "integer", "minimum": 0 }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "alignment": {
            "type": "string",
            "enum": ["agreed", "conflicted", "omission", "partial"]
          },
          "significance": { "type": "string", "enum": ["low", "moderate", "high"] },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "total": { "type": "integer" },
        "agreed": { "type": "integer" },
        "conflicted": { "type": "integer" },
        "omission": { "type": "integer" },
        "partial": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "run_meta": {
      "type": "object",
      "required": ["skill_version", "model", "timestamp_utc"],
      "properties": {
        "skill_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "model": { "type": "string" },
        "timestamp_utc": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
