# SERVER-ONLY Supabase configuration
# Never expose these values through EXPO_PUBLIC_* variables or bundle them into the mobile/web client.
SUPABASE_URL=https://<YOUR_PROJECT_REF>.supabase.co
SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_KEY>
SUPABASE_PUBLISHABLE_KEY=<YOUR_SUPABASE_PUBLISHABLE_KEY>
SUPABASE_JWKS_URL=https://<YOUR_PROJECT_REF>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_DB_URL=postgresql://<YOUR_DB_USER>:<YOUR_DB_PASSWORD>@<YOUR_DB_HOST>:5432/<YOUR_DB_NAME>
SUPABASE_JWT_EXPIRY=3600

# EXPO PUBLIC runtime configuration
# Only variables explicitly safe for client exposure belong in this section.
EXPO_PUBLIC_SUPABASE_URL=https://<YOUR_PROJECT_REF>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=<YOUR_SUPABASE_ANON_KEY>
EXPO_PUBLIC_SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<YOUR_SUPABASE_PUBLISHABLE_KEY>
EXPO_PUBLIC_SUPABASE_JWKS_URL=https://<YOUR_PROJECT_REF>.supabase.co/auth/v1/.well-known/jwks.json
EXPO_PUBLIC_AUTH_REDIRECT_URL=http://localhost:8099/welcome
EXPO_PUBLIC_PASSWORD_RESET_REDIRECT_URL=http://localhost:8099/reset-password

# SERVER-ONLY SafeSteps engines
SAFE_STEPS_ASSESSMENT_ENGINE_URL=<YOUR_ASSESSMENT_ENGINE_URL>
SAFE_STEPS_ASSESSMENT_ENGINE_KEY=<YOUR_ASSESSMENT_ENGINE_KEY>
SAFE_STEPS_READINESS_ENGINE_URL=<YOUR_READINESS_ENGINE_URL>
SAFE_STEPS_READINESS_ENGINE_KEY=<YOUR_READINESS_ENGINE_KEY>
SAFE_STEPS_CAPACITY_ENGINE_URL=<YOUR_CAPACITY_ENGINE_URL>
SAFE_STEPS_CAPACITY_ENGINE_KEY=<YOUR_CAPACITY_ENGINE_KEY>
SAFE_STEPS_DOC_ENGINE_URL=<YOUR_DOC_ENGINE_URL>
SAFE_STEPS_DOC_ENGINE_KEY=<YOUR_DOC_ENGINE_KEY>
SAFE_STEPS_EVIDENCE_EXTRACTOR_URL=<YOUR_EVIDENCE_EXTRACTOR_URL>
SAFE_STEPS_EVIDENCE_EXTRACTOR_KEY=<YOUR_EVIDENCE_EXTRACTOR_KEY>
SAFE_STEPS_FAIRNESS_ENGINE_URL=<YOUR_FAIRNESS_ENGINE_URL>
SAFE_STEPS_FAIRNESS_ENGINE_KEY=<YOUR_FAIRNESS_ENGINE_KEY>
SAFE_STEPS_RISK_ENGINE_URL=<YOUR_RISK_ENGINE_URL>
SAFE_STEPS_RISK_ENGINE_KEY=<YOUR_RISK_ENGINE_KEY>
SAFESTEPS_DOCUMENT_INTELLIGENCE_MODEL=gpt-4o-mini
SAFESTEPS_OPENAI_CONFIGURED=false
OPENAI_KEY=<YOUR_OPENAI_API_KEY>
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
AZURE_OPENAI_ENDPOINT=https://<YOUR_RESOURCE>.openai.azure.com

# SERVER-ONLY storage
SAFE_STEPS_STORAGE_BUCKET=<YOUR_STORAGE_BUCKET>
SAFE_STEPS_STORAGE_REGION=<YOUR_STORAGE_REGION>
SAFE_STEPS_STORAGE_SERVICE_URL=<YOUR_STORAGE_SERVICE_URL>
SAFE_STEPS_STORAGE_SERVICE_KEY=<YOUR_STORAGE_SERVICE_KEY>

# Parent-child runtime/services
SAFE_STEPS_CHILD_APP_URL=<YOUR_CHILD_APP_URL>
SAFE_STEPS_PARENT_APP_URL=<YOUR_PARENT_APP_URL>
SAFE_STEPS_SHARED_ITEMS_BUCKET=<YOUR_SHARED_ITEMS_BUCKET>
SAFE_STEPS_CHILD_NOTIFICATIONS_KEY=<YOUR_CHILD_NOTIFICATIONS_KEY>
SAFE_STEPS_PARENT_NOTIFICATIONS_KEY=<YOUR_PARENT_NOTIFICATIONS_KEY>

# Realtime services
SAFE_STEPS_REALTIME_URL=<YOUR_REALTIME_URL>
SAFE_STEPS_REALTIME_KEY=<YOUR_REALTIME_KEY>
SAFE_STEPS_NOTIFICATIONS_URL=<YOUR_NOTIFICATIONS_URL>
SAFE_STEPS_NOTIFICATIONS_KEY=<YOUR_NOTIFICATIONS_KEY>

# Automation / curriculum services
SAFE_STEPS_ETL_URL=<YOUR_ETL_URL>
SAFE_STEPS_ETL_KEY=<YOUR_ETL_KEY>
SAFE_STEPS_CURRICULUM_IMPORT_PATH=<YOUR_CURRICULUM_IMPORT_PATH>
SAFE_STEPS_CURRICULUM_ENGINE_URL=<YOUR_CURRICULUM_ENGINE_URL>
SAFE_STEPS_CURRICULUM_ENGINE_KEY=<YOUR_CURRICULUM_ENGINE_KEY>
EXPO_PUBLIC_SAFESTEPS_CURRICULUM_API_ENABLED=false
EXPO_PUBLIC_SAFESTEPS_API_URL=<YOUR_SAFESTEPS_API_URL>
EXPO_PUBLIC_SAFESTEPS_ENABLE_ADVANCED_ASSESSMENT_PREVIEWS=false

# SERVER-ONLY messaging
SAFE_STEPS_EMAIL_API_KEY=<YOUR_EMAIL_API_KEY>
SAFE_STEPS_SMS_API_KEY=<YOUR_SMS_API_KEY>
SAFE_STEPS_EMAIL_FROM=<YOUR_EMAIL_FROM_ADDRESS>
SAFE_STEPS_SMS_FROM=<YOUR_SMS_FROM_NUMBER>

# SERVER-ONLY payments
STRIPE_SECRET_KEY=<YOUR_STRIPE_SECRET_KEY>
STRIPE_WEBHOOK_SECRET=<YOUR_STRIPE_WEBHOOK_SECRET>
STRIPE_PUBLIC_KEY=<YOUR_STRIPE_PUBLIC_KEY>

# Local/server safety
SAFESTEPS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8099,http://localhost:19006
SAFESTEPS_ALLOWED_ORIGIN=http://localhost:8099
SAFESTEPS_ALLOW_UNAUTHENTICATED_LOCAL_API=false

# Controlled staging release verification only.
# These must point at a non-production Supabase project. Never commit real values.
SAFESTEPS_STAGING_URL=https://<STAGING_PROJECT_REF>.supabase.co
SAFESTEPS_STAGING_PUBLISHABLE_KEY=<STAGING_PUBLISHABLE_KEY>
SAFESTEPS_STAGING_SERVICE_ROLE_KEY=<STAGING_SERVICE_ROLE_KEY>
SAFESTEPS_STAGING_CASE_ID=<SYNTHETIC_CASE_UUID>
SAFESTEPS_STAGING_ROLE_CREDENTIALS_JSON={"parent":{"email":"parent+synthetic@example.test","password":"<STAGING_PASSWORD>"},"child":{"email":"child+synthetic@example.test","password":"<STAGING_PASSWORD>"},"caseworker":{"email":"caseworker+synthetic@example.test","password":"<STAGING_PASSWORD>"},"supervisor":{"email":"supervisor+synthetic@example.test","password":"<STAGING_PASSWORD>"},"court_viewer":{"email":"court-viewer+synthetic@example.test","password":"<STAGING_PASSWORD>"},"unrelated":{"email":"unrelated+synthetic@example.test","password":"<STAGING_PASSWORD>"}}
SAFESTEPS_STAGING_AUTH_BOOTSTRAP_APPLY=false
SAFESTEPS_SECURITY_ADVISOR_REVIEWED_AT=
SAFESTEPS_PERFORMANCE_ADVISOR_REVIEWED_AT=
SAFESTEPS_STAGING_JOURNEY_VERIFIED_AT=
SAFESTEPS_DEPENDENCY_AUDIT_REVIEWED_AT=
SAFESTEPS_CREDENTIAL_ROTATION_CONFIRMED_AT=
