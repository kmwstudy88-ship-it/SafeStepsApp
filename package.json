  "scripts": {
    "start": "expo start",
    "backend": "node backend/server.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "npx eas-cli@latest build --platform android --profile production",
    "build:ios": "npx eas-cli@latest build --platform ios --profile production",
    "build:preview": "npx eas-cli@latest build --platform all --profile preview",
    "db:status": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./SafeStepsTools/Invoke-SafeStepsDatabase.ps1 Status",
    "db:push": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./SafeStepsTools/Invoke-SafeStepsDatabase.ps1 Push",
    "db:verify": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./SafeStepsTools/Invoke-SafeStepsDatabase.ps1 Verify",
    "db:advisors": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./SafeStepsTools/Invoke-SafeStepsDatabase.ps1 Advisors",
    "db:security": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./SafeStepsTools/Invoke-SafeStepsDatabase.ps1 SecurityAudit",
    "db:new": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./SafeStepsTools/Invoke-SafeStepsDatabase.ps1 NewMigration",
    "smoke:document-intelligence": "node SafeStepsTools/smoke-document-intelligence-api.mjs",
    "test:backend": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --config jest.backend.config.cjs",
    "audit:found-curriculum": "node SafeStepsTools/audit-found-curriculum.js",
    "audit:curriculum-titles": "node SafeStepsTools/audit-curriculum-titles.js",
    "import:curriculum-source": "node SafeStepsTools/import-curriculum-source.js",
    "audit:routes": "node SafeStepsTools/audit-route-hygiene.js",
    "import:father-course": "node SafeStepsTools/import-father-course.js",
    "lint": "expo lint",
    "test": "jest --runInBand",
    "verify:staging": "node SafeStepsTools/verify-staging-journey.mjs",
    "bootstrap:staging-auth": "node SafeStepsTools/staging-auth-bootstrap.mjs",
    "release:gate": "node SafeStepsTools/production-readiness-gate.mjs"
  },
  "private": true,
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "uuid": "11.1.1"
  }
