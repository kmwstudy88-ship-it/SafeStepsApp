{
  "name": "safesteps-app",
  "version": "1.0.0",
  "private": true,
  "description": "SafeSteps child safety and reunification app, curriculum library, and supporting backend tooling.",
  "main": "expo-router/entry",
  "type": "commonjs",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "backend": "node backend/server.js",
    "verify:documents": "node tools/verify-document-intelligence.mjs",
    "smoke:documents": "node tools/verify-document-intelligence.mjs",
    "smoke:documents:live": "node tools/smoke-document-intelligence-live.mjs",
    "smoke:backend": "node tools/verify-document-intelligence.mjs",
    "validate": "npx expo-doctor",
    "content:index": "node tools/build-content-index.mjs",
    "content:readiness": "node tools/validate-curriculum-readiness.mjs",
    "readiness": "node tools/production-readiness-gate.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "~57.0.21",
    "expo-constants": "^57.0.17",
    "expo-document-picker": "^57.0.1",
    "expo-image-picker": "^57.0.16",
    "expo-linking": "~57.0.9",
    "expo-print": "^57.0.1",
    "expo-router": "^57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "^57.0.18",
    "expo-status-bar": "^57.0.1",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "typescript": "^7.0.2"
  }
