{
  "curriculum": "Alcohol and Other Drugs (AOD)",
  "version": "1.0",
  "description": "Complete structured curriculum covering addiction science, prevention, harm reduction, intervention, recovery, and social impact.",
  
  "modules": [
    {
      "module": "Foundations of AOD",
      "lessons": [
        "Introduction & Awareness",
        "Understanding Addiction",
        "Types of Substances",
        "Brain & Body Effects",
        "Addiction Science"
      ]
    },
    {
      "module": "Substances & Effects",
      "lessons": [
        "Alcohol Impacts",
        "Depressants",
        "Stimulants (Ice, Speed)",
        "Cannabis Use",
        "Prescription Drug Misuse",
        "Polydrug Use"
      ]
    },
    {
      "module": "Health & Behaviour",
      "lessons": [
        "Physical Signs",
        "Behavioural Signs",
        "Emotional Signs",
        "Mental Health Links",
        "Health Damage"
      ]
    },
    {
      "module": "Risk & Protection",
      "lessons": [
        "Risk Factors",
        "Protective Factors",
        "Triggers",
        "Peer Pressure",
        "Child Safety Risks"
      ]
    },
    {
      "module": "Family & Social Impact",
      "lessons": [
        "Family Impact",
        "Social Consequences",
        "Trauma & Substance Use",
        "Support Systems"
      ]
    },
    {
      "module": "Legal & Crisis",
      "lessons": [
        "Legal Consequences",
        "Overdose & Crisis",
        "Child Protection Considerations"
      ]
    },
    {
      "module": "Intervention & Recovery",
      "lessons": [
        "Intervention Skills",
        "Harm Reduction",
        "Recovery Pathways",
        "Recovery Planning",
        "Relapse Prevention",
        "Long-term Recovery"
      ]
    },
    {
      "module": "Healthy Recovery",
      "lessons": [
        "Healthy Lifestyle",
        "Emotional Regulation in Recovery",
        "Support Systems",
        "Recovery Identity Building"
      ]
    }
  ]
}